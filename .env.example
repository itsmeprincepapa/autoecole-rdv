# =========================================
# Modèle de configuration
# Copie ce fichier en ".env" et adapte les valeurs.
# Le vrai fichier .env n'est jamais envoyé sur GitHub.
# =========================================

# --- Base de données PostgreSQL ---
POSTGRES_USER=autoecole
POSTGRES_PASSWORD=change_me_en_local
POSTGRES_DB=autoecole_db
POSTGRES_PORT=5432


# --- Emails (SMTP) ---
# En développement : Mailpit (interface : http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Auto-ecole <no-reply@autoecole.local>