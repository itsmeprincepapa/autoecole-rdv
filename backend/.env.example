# =========================================
# Modèle de configuration du backend
# Copie ce fichier en ".env" et adapte les valeurs.
# Le vrai fichier .env n'est jamais envoyé sur GitHub.
# =========================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Base de données PostgreSQL ---
# Ces valeurs doivent être identiques à celles du .env de la racine
DB_HOST=localhost
DB_PORT=5432
DB_USER=autoecole
DB_PASSWORD=change_me_en_local
DB_NAME=autoecole_db

# --- Emails (SMTP) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Auto-ecole <no-reply@autoecole.local>

# --- JWT ---
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_aussi
JWT_REFRESH_EXPIRES_IN=7d


# --- Premier compte admin (script seed) ---
SEED_ADMIN_EMAIL=admin@autoecole.local
SEED_ADMIN_PASSWORD=change_me_Admin1
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Gerant