# =========================================
# Modèle de configuration du backend
# Copie ce fichier en ".env" et adapte les valeurs.
# Le vrai fichier .env n'est jamais envoyé sur GitHub.
# =========================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Base de données PostgreSQL ---
# Ces valeurs doivent être identiques à celles du .env de la racine
DB_HOST=localhost
DB_PORT=5432
DB_USER=autoecole
DB_PASSWORD=change_me_en_local
DB_NAME=autoecole_db